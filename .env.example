# ── Google Sheets (server-side only, never exposed to the browser) ─────────
# Service account email from Google Cloud Console (looks like
# xxxx@your-project.iam.gserviceaccount.com). Share your Google Sheet with
# this email as an "Editor" before the app can read/write it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key. Copy the "private_key" value from the JSON
# key file exactly as-is, including the BEGIN/END lines. When pasting into
# Vercel's dashboard, keep it as one value — Vercel preserves newlines.
# If you paste it into a local .env file instead, wrap it in quotes and
# keep the \n escape sequences (see README for details).
GOOGLE_PRIVATE_KEY=

# The Spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=

# Name of the tab/sheet the app reads and writes escalation submissions
# to. The app will create this tab automatically if it does not already
# exist — it will never touch or delete other tabs in the spreadsheet.
GOOGLE_SHEET_TAB=Escalations

# Name of the tab that holds your STANDARD City + Store master data. This
# tab must already exist with "City" and "Store" column headers (one row
# per store) — the app only ever READS this tab, never writes to it.
GOOGLE_MASTER_SHEET_TAB=Master

# ── Media storage (Vercel Blob) ─────────────────────────────────────────────
# Created automatically when you add the "Blob" storage integration to your
# Vercel project (Storage tab -> Create Database -> Blob). Vercel injects
# this automatically in production; only needed locally for `vercel dev`
# or `npm run dev` against real storage.
BLOB_READ_WRITE_TOKEN=
